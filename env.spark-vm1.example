# Copiar para .env na VM1 (mesmo diretório do compose) e ajustar valores.
# chmod 600 .env
#
#   cp env.spark-vm1.example .env

# ── Redes Docker (VM1) ───────────────────────────────────────────────────────
# Airflow (externa — deve existir antes do Spark; subnet 10.10.10.0/24):
#   .10 webserver  .11 scheduler  .12 worker  .13 triggerer
#   .14 dag-processor  .15 init  .20 postgres
# Spark na airflow_net: .30 master, .31 worker (não conflitam com o Airflow).
# Descobrir nome real: docker network ls | grep -i airflow
AIRFLOW_DOCKER_NETWORK=airflow_net_airflow

# Rede interna do cluster Spark (criada por docker-compose.spark-vm1.yml)
SPARK_DOCKER_NETWORK=spark_net
SPARK_DOCKER_SUBNET=10.10.20.0/24
SPARK_DOCKER_GATEWAY=10.10.20.1
SPARK_MASTER_CONTAINER_IP=10.10.20.10
SPARK_WORKER_1_CONTAINER_IP=10.10.20.11
SPARK_MASTER_AIRFLOW_NET_IP=10.10.10.30
SPARK_WORKER_1_AIRFLOW_NET_IP=10.10.10.31
# Segundo worker (opcional — sobe com --profile scale):
# SPARK_WORKER_2_CONTAINER_IP=10.10.20.12
# SPARK_WORKER_2_AIRFLOW_NET_IP=10.10.10.32
# SPARK_WORKER_2_MEMORY=
# SPARK_WORKER_2_CORES=

# Certificado público do MinIO (public.crt da VM2). Padrão: <SPARK_SECRETS_DIR>/minio_ca.crt
# SPARK_MINIO_CA_CERT=

# ── Lakehouse na VM2 (IP privado entre as VMs) ───────────────────────────────
# Mesmo IP usado em LAKEHOUSE_PRIVATE_BIND_ADDRESS na VM2.
MINIO_ENDPOINT=https://SUBSTITUA_IP_PRIVADO_VM2:9000
# Porta Thrift do Hive na VM2 (padrão 9083; ex.: 7077 se definido em HIVE_METASTORE_PORT na VM2)
HIVE_METASTORE_PORT=7077
HIVE_METASTORE_URI=thrift://SUBSTITUA_IP_PRIVADO_VM2:7077

# ── Diretório dos secrets na VM1 (arquivos um valor por linha, sem aspas) ────
SPARK_SECRETS_DIR=./.env_secrets

# ── Spark cluster (opcional) ─────────────────────────────────────────────────
SPARK_MASTER_UI_PORT=18080
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2
SPARK_UI_VIEW_ACLS=airflow,root
SPARK_UI_MODIFY_ACLS=airflow,root

# ── PostgreSQL operacional do Airflow (jobs que leem metadados/controle) ─────
POSTGRES_HOST=airflow-postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
