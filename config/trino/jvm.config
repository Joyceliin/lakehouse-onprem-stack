-server
# Precisa caber: query.max-memory-per-node + heap-headroom + overhead Trino < -Xmx.
# VM/host: reserve RAM para SO, MinIO, Hive, Postgres; não use este -Xmx se a VM
# tiver menos de ~24G livres no total da stack.
-Xmx16G
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+HeapDumpOnOutOfMemoryError
-XX:+ExitOnOutOfMemoryError
-Djdk.attach.allowAttachSelf=true
-Dfile.encoding=UTF-8
