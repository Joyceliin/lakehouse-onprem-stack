# Delta Lake
spark.sql.extensions                    io.delta.sql.DeltaSparkSessionExtension
spark.sql.catalog.spark_catalog         org.apache.spark.sql.delta.catalog.DeltaCatalog
# Grava metadados no Hive Metastore (visível no Trino como delta.<schema>.<table>)
spark.sql.catalogImplementation         hive

# MinIO (S3-compatible) — JARs em /opt/spark/extra-jars (bind mount) ou na imagem
spark.hadoop.fs.s3a.endpoint            ${MINIO_ENDPOINT}
spark.hadoop.fs.s3a.aws.credentials.provider software.amazon.awssdk.auth.credentials.EnvironmentVariableCredentialsProvider
spark.hadoop.fs.s3a.path.style.access   true
spark.hadoop.fs.s3a.impl                org.apache.hadoop.fs.s3a.S3AFileSystem
# HTTPS por padrão. O esquema de MINIO_ENDPOINT prevalece: a stack local de
# desenvolvimento usa http://minio:9000 e continua funcionando.
spark.hadoop.fs.s3a.connection.ssl.enabled true

# Hive Metastore remoto na VM2
spark.hadoop.hive.metastore.uris        ${HIVE_METASTORE_URI}

# Autenticação interna do Spark Standalone
spark.authenticate                      true
spark.authenticate.secret               ${SPARK_AUTH_SECRET}
spark.master.rest.enabled               false
spark.acls.enable                       true
spark.ui.view.acls                      ${SPARK_UI_VIEW_ACLS}
spark.modify.acls                       ${SPARK_UI_MODIFY_ACLS}
spark.ui.view.acls.groups               ${SPARK_UI_VIEW_ACLS_GROUPS}
spark.modify.acls.groups                ${SPARK_UI_MODIFY_ACLS_GROUPS}
spark.redaction.regex                   (?i)secret|password|token|access[.]?key|aws_access_key_id|aws_secret_access_key

# Performance
spark.sql.adaptive.enabled              true
spark.sql.adaptive.coalescePartitions.enabled true
# Teto inicial de partições de shuffle: o AQE só junta partições, não cria.
# Com 200, cargas grandes não ficam presas em poucas partições gigantes e as
# pequenas são coalescidas em tempo de execução.
spark.sql.shuffle.partitions            200

# Delta auto-otimização
spark.databricks.delta.optimizeWrite.enabled  true
spark.databricks.delta.autoCompact.enabled     true
