{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::bronze",
        "arn:aws:s3:::bronze/*",
        "arn:aws:s3:::landing",
        "arn:aws:s3:::landing/*",
        "arn:aws:s3:::markers",
        "arn:aws:s3:::markers/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::silver",
        "arn:aws:s3:::silver/*",
        "arn:aws:s3:::gold",
        "arn:aws:s3:::gold/*",
        "arn:aws:s3:::markers",
        "arn:aws:s3:::markers/*",
        "arn:aws:s3:::landing",
        "arn:aws:s3:::landing/*"
      ]
    }
  ]
}
