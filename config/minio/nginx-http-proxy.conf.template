# HTTP :9001 — HAProxy do storage
#   /browser/*  → Console :9001 (strip /browser → MIME/static/API corretos)
#   /api /ws    → Console :9001 (chamadas sem prefixo)
#   /           → API S3 :9000 (MINIO_SERVER_URL no mesmo FQDN)
# Airflow/clientes S3 usam host :9000 (TLS direto), não esta porta.
# ${MINIO_PUBLIC_HOST} via envsubst.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      https;
}

server {
    listen 80 default_server;
    server_name _;
    return 403;
}

server {
    listen 80;
    server_name ${MINIO_PUBLIC_HOST};

    client_max_body_size 0;
    ignore_invalid_headers off;
    proxy_buffering off;
    proxy_request_buffering off;
    chunked_transfer_encoding off;

    location = /browser {
        return 301 /browser/;
    }

    # Console UI + /browser/api + /browser/static (strip do prefixo)
    location /browser/ {
        rewrite ^/browser/(.*) /$1 break;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-NginX-Proxy true;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_pass https://minio:9001;

        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location /api {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_pass https://minio:9001;
    }

    location /ws {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_pass https://minio:9001;
    }

    # API S3 + health (mesmo FQDN = MINIO_SERVER_URL)
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_pass https://minio:9000;
    }
}
