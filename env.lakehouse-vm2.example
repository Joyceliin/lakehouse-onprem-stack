# Copiar para .env na VM2 (mesmo diretório do compose) e ajustar valores.
# chmod 600 .env
# chmod 700 .env_secrets
#
#   cp env.lakehouse-vm2.example .env
#
# NÃO colocar neste arquivo: senhas, access/secret keys, truststore password,
# shared secrets Trino. Esses ficam em LAKEHOUSE_SECRETS_DIR (um valor por arquivo).

# IP privado desta VM (bind das portas expostas)
LAKEHOUSE_PRIVATE_BIND_ADDRESS=SUBSTITUA_IP_PRIVADO_VM2

# Firewall (host): allowlist estrita
#   Orquestrador/S3  → VM2:9000   (MinIO API HTTPS)
#   HAProxy (só)     → VM2:9001   (nginx → Console/web; Host = MINIO_TLS_DNS)
#   Clientes BI      → VM2:${TRINO_HOST_PORT}  (Trino HTTPS) — só se necessário
# Hive Thrift NÃO é publicado no host — só rede Docker (Trino → hive-metastore).
# Negar qualquer outra origem nas portas 9000 e 9001.

# Porta Thrift do Hive Metastore (padrão upstream: 9083).
# Se mudar (ex. 7077), o entrypoint montado passa -p para o processo escutar a mesma porta
# e o Trino usa thrift://hive-metastore:<porta>. Sem rebuild (volume no compose).
HIVE_METASTORE_PORT=7077

# Diretório dos secrets (arquivos um valor por linha, sem aspas)
LAKEHOUSE_SECRETS_DIR=./.env_secrets
# Diretório de dados do MinIO no host (padrão: /dados/minio)
# MINIO_DATA_DIR=
# Contas MinIO (depois do minio-init):
#   Internos (JSON fixo):  ./scripts/minio/set-user.sh trino|hive --write-secrets
#   Novos (sem JSON):      ./scripts/minio/set-user.sh svc_r5n1 --read silver/projeto_x
#   Reexecutar infra:      bash scripts/minio/bootstrap.sh
# Detalhe: config/minio/POLICIES-VERIFICACAO.md
#
# Gerar/atualizar usuários Trino (senha NÃO fica em arquivo — só hash em password.db):
#   ./scripts/trino/set-user.sh usr_k4t9 admin          # imprime senha UMA vez
#   ./scripts/trino/set-user.sh usr_m2x7 engenharia --prompt  # você digita
# Arquivos: .env_secrets/trino_password.db (bcrypt), trino_groups.txt (sem senhas)
# Guarde a senha exibida em cofre/password manager. Pode apagar trino_users/ se existir.
# Níveis: admin (total) | engenharia (bronze+silver+gold) | analista (silver+gold)
# ACL + groups: config/trino/ACL-VERIFICACAO.md
#
# Memória Trino (config/trino): ~12GB/query/nó, heap -Xmx16G — VM com ≥24G RAM livre p/ stack.

# Trino — HTTPS na porta 8080 do host (mapeada para TLS 8443 no container); HTTP sem criptografia não exposto
TRINO_HOST_PORT=8080

# MinIO — audit webhook (destino EXTERNO; nunca o próprio MinIO). off até ter endpoint.
# MINIO_AUDIT_WEBHOOK_ENABLE=on
# MINIO_AUDIT_WEBHOOK_ENDPOINT=https://SIEM_OU_COLETOR_INTERNO/minio-audit
MINIO_AUDIT_WEBHOOK_ENABLE=off
# MINIO_AUDIT_WEBHOOK_ENDPOINT=

# ── MinIO HTTPS / web ────────────────────────────────────────────────────────
# Um FQDN (SAN do cert + nginx Host + URLs públicas). Sem https:// e sem porta.
MINIO_TLS_DNS=SUBSTITUA_FQDN_MINIO
# Gerar certs: set -a && source .env && set +a && bash scripts/minio/gen-tls-certs.sh
LAKEHOUSE_MINIO_CERTS_DIR=./config/minio/certs
# Interno Docker (Hive/Trino/minio-init)
MINIO_ENDPOINT=https://minio:9000
# O compose deriva (não precisa no .env):
#   MINIO_SERVER_URL / MINIO_BROWSER_REDIRECT_URL (/browser) / MINIO_PUBLIC_HOST
# Host: porta API TLS (orquestrador), porta nginx (só balanceador)
#
# Policies: config/minio/POLICIES-VERIFICACAO.md
